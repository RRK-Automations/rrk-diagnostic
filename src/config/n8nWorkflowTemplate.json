    {
      "parameters": {
        "jsCode": "const apt = $input.first().json.body.appointment;\n\nreturn {\n  bookingId: apt.id,\n  patientName: apt.patientName,\n  phone: apt.phone,\n  email: apt.email || 'N/A',\n  service: apt.service,\n  bookingType: apt.bookingType === 'home_collection' ? 'Home Sample Collection' : 'Clinic Walk-in',\n  scheduledDate: apt.preferredDate,\n  scheduledTime: apt.preferredTime,\n  address: apt.address || 'N/A',\n  landmark: apt.landmark || 'N/A',\n  googleMapsUrl: apt.googleMapsNavigationUrl || 'N/A',\n  fastingInstructions: apt.fastingGuidelines || 'Standard hydration',\n  referringDoctor: apt.referringDoctor || 'Self / Walk-in',\n  status: apt.status || 'New Request',\n  createdAt: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })\n};"
      },
      "id": "format-booking-data",
      "name": "Format Booking Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        320
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1AshaJyothiGoogleSheetId",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Appointments",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },

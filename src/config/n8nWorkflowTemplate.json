    {
      "parameters": {
        "method": "POST",
        "url": "https://api.whatsapp.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"917386320634\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 *NEW HOME BLOOD COLLECTION DISPATCH* 🚨\\n\\n👤 *Patient:* {{ $json.patientName }}\\n📞 *Phone:* {{ $json.phone }}\\n🧪 *Package/Test:* {{ $json.service }}\\n⏰ *Fasting Slot:* {{ $json.scheduledDate }} ({{ $json.scheduledTime }})\\n📍 *Address:* {{ $json.address }}\\n🏛️ *Landmark:* {{ $json.landmark }}\\n\\n🗺️ *1-Click Google Maps Navigation:*\\n{{ $json.googleMapsUrl }}\\n\\n_Asha Jyothi Diagnostics - Phlebotomy Dispatch_\"\n  }\n}",
        "options": {}
      },
      "id": "whatsapp-phlebotomist-dispatch",
      "name": "WhatsApp: Phlebotomist Dispatch Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.whatsapp.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🏥 *Asha Jyothi Diagnostic Centre, Toopran*\\n\\nDear {{ $json.patientName }},\\nYour appointment request for *{{ $json.service }}* is registered.\\n\\n📅 *Date:* {{ $json.scheduledDate }}\\n⏰ *Slot:* {{ $json.scheduledTime }}\\n🔖 *Ref ID:* {{ $json.bookingId }}\\n\\n⚠️ *Preparation Guidelines:*\\n{{ $json.fastingInstructions }}\\n\\n📍 *Location:* 13-21/1/A, Keshava Nagar Colony, Toopran.\\n📞 *Contact:* +91 73863 20634\"\n  }\n}",
        "options": {}
      },
      "id": "whatsapp-patient-confirmation",
      "name": "WhatsApp: Patient Confirmation & Fasting Rules",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        500
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "start": "={{ $json.scheduledDate }}T08:00:00+05:30",
        "end": "={{ $json.scheduledDate }}T08:30:00+05:30",
        "additionalFields": {
          "summary": "={{ $json.bookingType }}: {{ $json.service }} - {{ $json.patientName }}",
          "description": "=Patient Phone: {{ $json.phone }}\nDoctor Ref: {{ $json.referringDoctor }}\nFasting Instructions: {{ $json.fastingInstructions }}\nAddress: {{ $json.address }}"
        }
      },
      "id": "gcal-radiologist-slot",
      "name": "Google Calendar: Schedule Slot",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        1200,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const rpt = $input.first().json.body.report;\nlet p = String(rpt.phone || '').replace(/[^0-9]/g, '');\nif (p.length === 10) p = '91' + p;\n\nreturn {\n  reportId: rpt.id,\n  reportCode: rpt.reportCode,\n  patientName: rpt.patientName,\n  phone: p,\n  testName: rpt.testName,\n  doctorName: rpt.doctorName,\n  testDate: rpt.testDate,\n  downloadUrl: rpt.downloadPortalUrl,\n  whatsappText: rpt.whatsappMessageDraft\n};"
      },
      "id": "format-report-data",
      "name": "Format Report Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        640
      ]
    },

        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"📄 *DIAGNOSTIC REPORT READY FOR DOWNLOAD*\\n\\nDear {{ $json.patientName }},\\n\\nYour verified test report for *{{ $json.testName }}* conducted on {{ $json.testDate }} has been published by {{ $json.doctorName }}.\\n\\n🔗 *Download Official PDF Report:*\\n{{ $json.downloadUrl }}\\n\\n🔖 *Report Code:* `{{ $json.reportCode }}`\\n\\n_Asha Jyothi Diagnostic Centre, Keshava Nagar Colony, Toopran (Ph: +91 73863 20634)_\"\n  }\n}",
        "options": {}
      },

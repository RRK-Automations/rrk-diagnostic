          "mode": "name"
        },
        "sheetName": {
          "__rl": true,
          "value": "Appointments",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.preferredDate }}",
            "Time": "={{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.preferredTime }}",
            "Patient Name": "={{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.patientName }}",
            "Contact": "={{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.phone }}",
            "Doctor": "Self / WhatsApp Bot",

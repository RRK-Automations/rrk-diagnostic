{
  "name": "Asha Jyothi Diagnostics - Unified WhatsApp Conversational Chatbot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "meta-get-verify",
      "name": "Meta Webhook: Verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        180
      ],
      "webhookId": "meta-whatsapp-verify"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query && $json.query['hub.challenge'] ? $json.query['hub.challenge'] : 'VERIFIED' }}",
        "options": {}
      },
      "id": "meta-verify-response",
      "name": "Respond Challenge to Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        420,
        180
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "meta-inbound-post",
      "name": "Meta Webhook: Inbound Messages (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        420
      ],
      "webhookId": "meta-whatsapp-inbound"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst entry = body && body.entry && body.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst value = change && change.value;\n\n// Ignore delivery/read receipts\nif (!value || !value.messages || value.messages.length === 0) {\n  return [];\n}\n\nconst message = value.messages[0];\nconst contact = value.contacts && value.contacts[0];\n\nlet fromPhone = String(message.from || '').replace(/[^0-9]/g, '');\nif (fromPhone.length === 10) fromPhone = '91' + fromPhone;\n\nconst patientName = (contact && contact.profile && contact.profile.name) || 'Valued Patient';\nconst messageText = message.text ? message.text.body.trim() : '';\n\nreturn {\n  phone: fromPhone,\n  name: patientName,\n  message: messageText\n};"
      },
      "id": "parse-meta-inbound",
      "name": "Extract Patient & Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rrk-diagnostic.vercel.app/api/whatsapp-bot",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"name\": \"{{ $json.name }}\",\n  \"message\": \"{{ $json.message }}\"\n}",
        "options": {}
      },
      "id": "call-bot-engine",
      "name": "Call Conversational Engine (/api/whatsapp-bot)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.fromPhone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.replyText) }}\n  }\n}",
        "options": {}
      },
      "id": "send-patient-reply",
      "name": "WhatsApp: Send Conversational Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.actionTaken }}",
              "rightValue": "APPOINTMENT_CREATED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-appointment-created",
      "name": "Was Appointment Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1180,
        420
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "Master Hub Tracker Ready",
          "mode": "name"
        },
        "sheetName": {
          "__rl": true,
          "value": "Appointments",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.bookingCreated.preferredDate }}",
            "Time": "={{ $json.bookingCreated.preferredTime }}",
            "Patient Name": "={{ $json.bookingCreated.patientName }}",
            "Contact": "={{ $json.bookingCreated.phone }}",
            "Doctor": "Self / WhatsApp Bot",
            "Service": "={{ $json.bookingCreated.service }}",
            "Status": "New",
            "Notes": "=WhatsApp Booking | Address: {{ $json.bookingCreated.address }}",
            "Payment Status": "Pending at Centre",
            "Payment Method": "Cash / UPI",
            "Amount": "To be billed",
            "Source": "WhatsApp In-Chat Bot",
            "Assigned To": "={{ $json.bookingCreated.bookingType === 'home_collection' ? 'Phlebotomist' : 'Reception' }}"
          }
        },
        "options": {}
      },
      "id": "sheets-append-chatbot-booking",
      "name": "Google Sheets: Log In-Chat Booking",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1440,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WHATSAPP_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"917386320634\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 *NEW WHATSAPP IN-CHAT BOOKING* 🚨\\n\\n👤 *Patient:* {{ $json.bookingCreated.patientName }}\\n📞 *Phone:* {{ $json.bookingCreated.phone }}\\n🧪 *Service:* {{ $json.bookingCreated.service }}\\n📍 *Type:* {{ $json.bookingCreated.bookingType }}\\n🏠 *Address:* {{ $json.bookingCreated.address || 'Clinic Walk-in' }}\\n⏰ *Slot:* {{ $json.bookingCreated.preferredTime }}\\n\\n🗺️ *1-Click Navigation:*\\nhttps://www.google.com/maps/search/?api=1&query={{ encodeURIComponent($json.bookingCreated.address + ', Toopran, Telangana') }}\\n\\n_Asha Jyothi Diagnostics Automation_\"\n  }\n}",
        "options": {}
      },
      "id": "whatsapp-phlebotomist-alert-chatbot",
      "name": "WhatsApp: Alert Phlebotomist / Staff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        520
      ]
    }
  ],
  "connections": {

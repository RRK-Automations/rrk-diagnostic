            "Payment Status": "Pending at Centre",
            "Payment Method": "Cash / UPI",
            "Amount": "To be billed",
            "Source": "WhatsApp In-Chat Bot",
            "Assigned To": "={{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.bookingType === 'home_collection' ? 'Phlebotomist' : 'Reception' }}"
          }
        },
        "options": {}
      },
      "id": "sheets-append-chatbot-booking",
      "name": "Google Sheets: Log In-Chat Booking",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1100,
        480
      ]
    },
    {

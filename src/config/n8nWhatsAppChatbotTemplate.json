        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"917386320634\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 *NEW WHATSAPP IN-CHAT BOOKING* 🚨\\n\\n👤 *Patient:* {{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.patientName }}\\n📞 *Phone:* {{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.phone }}\\n🧪 *Service:* {{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.service }}\\n📍 *Type:* {{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.bookingType }}\\n🏠 *Address:* {{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.address || 'Clinic Walk-in' }}\\n⏰ *Slot:* {{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.preferredTime }}\\n\\n🗺️ *1-Click Navigation:*\\nhttps://www.google.com/maps/search/?api=1&query={{ encodeURIComponent(($('Call Conversational Engine (/api/whatsapp-bot)').item.json.bookingCreated.address || '') + ', Toopran, Telangana') }}\\n\\n_Asha Jyothi Diagnostics Automation_\"\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "meta-whatsapp-auth",
          "name": "Meta WhatsApp Auth"
        }
      },
      "id": "whatsapp-phlebotomist-alert-chatbot",

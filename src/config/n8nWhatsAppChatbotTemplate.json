    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Safely extract Meta WhatsApp payload structures\nconst entry = body && body.entry && body.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst value = change && change.value;\n\n// If status update (sent/delivered/read receipt), ignore gracefully\nif (!value || !value.messages || value.messages.length === 0) {\n  return [];\n}\n\nconst message = value.messages[0];\nconst contact = value.contacts && value.contacts[0];\n\nconst rawPhone = message.from; // e.g. 917386320634\nconst patientName = (contact && contact.profile && contact.profile.name) || 'Valued Patient';\nconst messageText = message.text ? message.text.body.trim() : '';\nconst lower = messageText.toLowerCase();\n\nlet intent = 'menu';\n\nif (lower === '1' || lower.includes('book') || lower.includes('appointment') || lower.includes('scan') || lower.includes('home') || lower.includes('test')) {\n  intent = 'booking';\n} else if (lower === '2' || lower.includes('report') || lower.includes('result') || lower.includes('download') || lower.includes('pdf')) {\n  intent = 'reports';\n} else if (lower === '3' || lower.includes('package') || lower.includes('pricing') || lower.includes('checkup') || lower.includes('cost') || lower.includes('price')) {\n  intent = 'packages';\n} else if (lower === '4' || lower.includes('location') || lower.includes('timing') || lower.includes('address') || lower.includes('map') || lower.includes('where') || lower.includes('hours')) {\n  intent = 'location';\n} else if (lower === '5' || lower.includes('human') || lower.includes('reception') || lower.includes('talk') || lower.includes('call') || lower.includes('doctor')) {\n  intent = 'human_support';\n} else if (lower === 'hi' || lower === 'hello' || lower === 'hey' || lower === 'menu' || lower === 'start' || lower === 'help' || lower === 'namaste') {\n  intent = 'menu';\n} else {\n  intent = 'general_enquiry';\n}\n\nreturn {\n  patientPhone: rawPhone,\n  patientName: patientName,\n  messageText: messageText,\n  intent: intent,\n  timestamp: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })\n};"
      },

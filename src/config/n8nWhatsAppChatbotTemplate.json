{
  "name": "Asha Jyothi Diagnostics - Unified WhatsApp Conversational Chatbot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "meta-get-verify",
      "name": "Meta Webhook: Verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        140,
        180
      ],
      "webhookId": "meta-whatsapp-verify"
    },
    {
      "parameters": {
        "jsCode": "const query = $input.first().json.query || {};\nconst verifyToken = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\n// Check verify token against environment or standard secret (Issue #8)\nif (verifyToken === 'demo_webhook_secret_token') {\n  return { challenge: challenge || 'VERIFIED' };\n}\n\nthrow new Error('Forbidden: Invalid Webhook Verification Token');"
      },
      "id": "validate-meta-challenge",
      "name": "Validate Verification Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {}
      },
      "id": "meta-verify-response",
      "name": "Respond Challenge to Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        620,
        180
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "meta-inbound-post",
      "name": "Meta Webhook: Inbound Messages (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        140,
        420
      ],
      "webhookId": "meta-whatsapp-inbound"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst entry = body && body.entry && body.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst value = change && change.value;\n\nif (!value || !value.messages || value.messages.length === 0) {\n  return [];\n}\n\n// Support batch messages (Issue #10)\nconst out = [];\nfor (const message of value.messages) {\n  const contact = value.contacts && value.contacts[0];\n  let fromPhone = String(message.from || '').replace(/[^0-9]/g, '');\n  if (fromPhone.length === 10) fromPhone = '91' + fromPhone;\n\n  const patientName = (contact && contact.profile && contact.profile.name) || 'Valued Patient';\n  let messageText = '';\n\n  // Handle media & interactive fallbacks (Issue #9)\n  if (message.type === 'text' && message.text) {\n    messageText = message.text.body.trim();\n  } else if (message.type === 'interactive' && message.interactive) {\n    messageText = message.interactive.button_reply?.title || message.interactive.list_reply?.title || '';\n  } else if (message.type === 'location' && message.location) {\n    messageText = `Location: ${message.location.latitude}, ${message.location.longitude}`;\n  } else {\n    messageText = `[UNSUPPORTED_${message.type?.toUpperCase()}]`;\n  }\n\n  out.push({\n    phone: fromPhone,\n    name: patientName,\n    message: messageText,\n    rawType: message.type\n  });\n}\n\nreturn out;"
      },
      "id": "parse-meta-inbound",
      "name": "Extract Patient & Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rrk-diagnostic.vercel.app/api/whatsapp-bot",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"name\": \"{{ $json.name }}\",\n  \"message\": \"{{ $json.message }}\"\n}",
        "options": {}
      },
      "id": "call-bot-engine",
      "name": "Call Conversational Engine (/api/whatsapp-bot)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        420
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.fromPhone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($('Call Conversational Engine (/api/whatsapp-bot)').item.json.replyText) }}\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "meta-whatsapp-auth",
          "name": "Meta WhatsApp Auth"
        }
      },
      "id": "send-patient-reply",
      "name": "WhatsApp: Send Conversational Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Call Conversational Engine (/api/whatsapp-bot)').item.json.actionTaken }}",
              "rightValue": "APPOINTMENT_CREATED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-appointment-created",
      "name": "Was Appointment Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        860,
        540
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
